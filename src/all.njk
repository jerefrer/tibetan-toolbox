---
layout: layouts/base.njk
title: All tools
description: Every tool in the Tibetan Toolbox in one searchable list - filter by need, platform, price, open source and developer libraries.
catalogueHeader: true
bodyClass: catalogue
scripts:
  - /assets/js/search.js
  - /assets/js/catalogue.js
---
{% from "partials/macros.njk" import toolCard %}
<div class="wrap wrap--wide cat">
  <aside class="filters" aria-label="Filters" data-filters hidden>
    <form id="filter-form" onsubmit="return false">
      <fieldset>
        <legend>Need</legend>
        {%- for n in needs %}
        <label><input type="checkbox" name="need" value="{{ n.id }}">{{ n.filter }}</label>
        {%- endfor %}
      </fieldset>
      <fieldset>
        <legend>Works on</legend>
        {%- for p in platforms %}
        <label><input type="checkbox" name="platform" value="{{ p.id }}">{{ p.name }}</label>
        {%- endfor %}
      </fieldset>
      <fieldset>
        <legend>Show</legend>
        <label><input type="checkbox" name="free" value="1">Free only</label>
        <label><input type="checkbox" name="open" value="1">Open source only</label>
        <label><input type="checkbox" name="dev" value="1">Developer libraries only</label>
      </fieldset>
      <button type="reset" class="linkbtn" id="reset-filters">Clear filters</button>
    </form>
  </aside>

  <section class="results" aria-labelledby="all-heading">
    <h1 id="all-heading" class="results__title">All tools</h1>
    <p class="results__summary" id="summary" aria-live="polite">{{ tools.length }} tools, in alphabetical order, with fonts and developer libraries last.</p>
    <div class="tool-list" id="tool-list">
      {%- for t in tools | userTools | fontsLast %}{{ toolCard(t, needs, platforms, true) }}{% endfor %}
      {%- for t in tools | devTools %}{{ toolCard(t, needs, platforms, true) }}{% endfor %}
    </div>
    <p class="empty" id="empty" hidden>No tool matches. Try fewer filters or another word, or <a href="{{ '/suggest/' | url }}">suggest a tool</a>.</p>
  </section>
</div>
