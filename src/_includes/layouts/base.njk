<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title if isHome else (title + " - " + site.name) %}
  {%- set canonical = site.origin + (page.url | url) %}
  {%- set ogImage = site.origin + ('/assets/img/og-image.png' | url) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="theme-color" content="#ffffff">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Tibetan Toolbox - What do you want to do?">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Noto+Serif+Tibetan:wght@400;600&display=swap">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  {%- if jsonld %}
  <script type="application/ld+json">{{ jsonld | jsonLd | safe }}</script>
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  {% if catalogueHeader %}
  <header class="site-header site-header--bar">
    <div class="wrap wrap--wide header-row">
      <a class="brand" href="{{ '/' | url }}"><span class="brand__name">{{ site.name }}</span><span class="brand__bo" lang="bo">{{ site.tibetanName }}</span></a>
      <form class="header-search" role="search" action="{{ '/all/' | url }}" method="get">
        <label class="sr-only" for="search">Search tools</label>
        <input id="search" name="q" type="search" placeholder="Search tools: OCR, Wylie, fonts…" autocomplete="off">
      </form>
      <a class="btn btn--outline" href="{{ '/suggest/' | url }}">Suggest a tool</a>
    </div>
  </header>
  {% else %}
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="{{ '/' | url }}"><span class="brand__name">{{ site.name }}</span><span class="brand__bo" lang="bo">{{ site.tibetanName }}</span></a>
      <nav class="nav" aria-label="Main">
        <a href="{{ '/' | url }}#needs">By need</a>
        <a href="{{ '/all/' | url }}"{% if page.url == '/all/' %} aria-current="page"{% endif %}>All tools</a>
        <a href="{{ '/developers/' | url }}"{% if page.url == '/developers/' %} aria-current="page"{% endif %}>For developers</a>
        <a class="nav__suggest" href="{{ '/suggest/' | url }}"{% if page.url == '/suggest/' %} aria-current="page"{% endif %}>Suggest a tool</a>
      </nav>
    </div>
  </header>
  {% endif %}

  <main id="main">
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap{% if catalogueHeader %} wrap--wide{% endif %} footer-row">
      <span class="footer-who">
        <img src="{{ '/assets/img/jeremy.png' | url }}" alt="" width="28" height="28">
        <span>Maintained by <a href="{{ site.maintainer.url }}" rel="noopener">{{ site.maintainer.name }}</a> · <a href="{{ site.maintainer.support }}" rel="noopener">Support this work</a></span>
      </span>
      <span class="footer-links"><a href="{{ '/suggest/' | url }}">Suggest a tool</a> · <a href="{{ site.repo }}" rel="noopener">GitHub</a></span>
    </div>
    <div class="wrap{% if catalogueHeader %} wrap--wide{% endif %} footer-note">
      <p>Every tool listed here belongs to its author. This directory only links to them and takes no credit for them.</p>
    </div>
  </footer>
{%- if scripts %}{% for s in scripts %}
  <script src="{{ s | url }}" defer></script>
{%- endfor %}{% endif %}
</body>
</html>
