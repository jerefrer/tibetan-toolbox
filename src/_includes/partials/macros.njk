{# A tool as a catalogue row. Developer libraries get the dashed card.
   The whole card opens the tool: the name's link is stretched over it, and the
   author and category links sit above it so that they still work. #}
{% macro toolCard(t, needs, platformList, showNeeds) %}
{%- set isGithub = t.url | hostOf == "github.com" -%}
<article class="tool{% if t.developer %} tool--dev{% endif %}" id="tool-{{ t.id }}"
  data-id="{{ t.id }}"
  data-needs="{{ t.needs | join(' ') }}"
  data-platforms="{{ t.platforms | join(' ') }}"
  data-free="{{ 'true' if t.free else 'false' }}"
  data-open="{{ 'true' if t.openSource else 'false' }}"
  data-dev="{{ 'true' if t.developer else 'false' }}">
  <div class="tool__body">
    <div class="tool__head">
      <img class="tool__icon" src="{{ ('/assets/img/tools/' + t.id + '.png') | url }}" alt="" width="40" height="40" loading="lazy">
      <h3 class="tool__name"><a class="tool__stretch" href="{{ t.url }}" rel="noopener">{{ t.name }}<span class="sr-only"> (opens another site)</span></a></h3>
      <span class="tool__by">
        {%- if t.developer -%}developer library{% if t.language %} · {{ t.language }}{% endif %} · {% endif -%}
        by {% for a in t | authorsOf %}<a href="{{ a.url }}" rel="noopener">{{ a.name }}</a>{% if not loop.last %}{{ " and " if loop.revindex == 2 else ", " }}{% endif %}{% endfor %}{% if t.madeFor %} for <a href="{{ t.madeFor.url }}" rel="noopener">{{ t.madeFor.name }}</a>{% endif %}
      </span>
    </div>
    <p class="tool__desc">{{ t.description }}</p>
    {%- if t.specimen %}
    <img class="tool__specimen" src="{{ ('/assets/img/specimens/' + t.id + '.png') | url }}" alt="བཀྲ་ཤིས་བདེ་ལེགས། set in {{ t.name }}" width="{{ t.specimen[0] }}" height="{{ t.specimen[1] }}" loading="lazy">
    {%- endif %}
    {% if not t.developer or t.platforms.length %}
    <ul class="pills" aria-label="Details">
      {%- for p in t.platforms %}{% for pl in platformList %}{% if pl.id == p %}<li>{{ pl.short }}</li>{% endif %}{% endfor %}{% endfor -%}
      {%- if t.free %}<li>Free</li>{% else %}<li class="pill--paid">Paid</li>{% endif -%}
      {%- if t.openSource %}<li>Open source</li>{% endif -%}
    </ul>
    {% elif t.free or t.openSource %}
    <ul class="pills" aria-label="Details">
      {%- if t.free %}<li>Free</li>{% else %}<li class="pill--paid">Paid</li>{% endif -%}
      {%- if t.openSource %}<li>Open source</li>{% endif -%}
    </ul>
    {% endif %}
    {% if showNeeds %}
    <p class="tool__needs">{% for n in t.needs %}<a href="{{ ('/' + n + '/') | url }}">{{ n | needName(needs) }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
    {% endif %}
  </div>
  {#- Kept as a visual cue; the name's link already covers the card. #}
  <span class="{{ 'tool__link' if t.developer or isGithub else 'btn' }}{% if not t.free %} btn--paid{% endif %}" aria-hidden="true">
    {%- if t.cta %}{{ t.cta }}{% elif isGithub %}View on GitHub{% else %}Open{% endif -%}
  </span>
</article>
{% endmacro %}
