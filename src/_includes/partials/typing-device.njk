{# One platform's guide: video, steps, download, notes and font. Expects `d`. #}
<p class="device__lead">{{ d.lead }}</p>
{%- if d.video %}
<div class="video">
  <iframe src="https://www.youtube-nocookie.com/embed/{{ d.video.id }}" title="{{ d.video.title }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>
<p class="video__caption">{{ d.video.title }} - <a href="https://www.youtube.com/watch?v={{ d.video.id }}" rel="noopener">watch on YouTube</a></p>
{%- endif %}
{%- if d.steps.length %}
<ol class="steps">
  {%- for s in d.steps %}<li>{{ s | inline | safe }}</li>{% endfor %}
</ol>
{%- endif %}
{%- if d.id == 'windows' %}
<p class="actions">
  <a class="btn" href="{{ typing.windowsKeyboard.x64 }}" rel="noopener">Download the keyboard for Windows</a>
</p>
<p class="small"><a href="{{ typing.windowsKeyboard.arm64 }}" rel="noopener">For a Windows computer with an ARM processor, such as a Surface Pro X, download this version instead.</a> <a href="{{ typing.windowsKeyboard.reference }}" rel="noopener">Every combination the keyboard accepts<span class="sr-only"> (on GitHub, opens another site)</span></a>. The keyboard is the free, open source <a href="https://github.com/bkntr/tibetan-keyboard" rel="noopener">Tibetan EWTS Keyboard</a> by bkntr.</p>
{%- endif %}
{%- if d.notes.length %}
<ul class="notes">
  {%- for n in d.notes %}<li>{{ n | inline | safe }}</li>{% endfor %}
</ul>
{%- endif %}
{%- if d.id == 'mac' %}
{#- Where the stacking key is, drawn: Shift plus the key just left of Delete. The key is the same place on every Mac keyboard (macOS maps keys by position), so the drawing leaves its label blank unless the browser can say it: see stacking-key.js. #}
<figure class="keyfig" data-stacking-figure>
  <svg class="keyfig__svg" viewBox="0 0 424 56" role="img" aria-label="Keyboard keys: Shift, then the key just left of Delete, highlighted">
    <rect class="keyfig__hot" x="1" y="1" width="98" height="54" rx="8"/>
    <text class="keyfig__hot-text" x="50" y="34" text-anchor="middle">&#8679; shift</text>
    <text class="keyfig__plus" x="119" y="36" text-anchor="middle">+</text>
    <rect class="keyfig__key" x="141" y="1" width="44" height="54" rx="8"/>
    <text class="keyfig__text" x="163" y="34" text-anchor="middle">9</text>
    <rect class="keyfig__key" x="191" y="1" width="44" height="54" rx="8"/>
    <text class="keyfig__text" x="213" y="34" text-anchor="middle">0</text>
    <rect class="keyfig__key" x="241" y="1" width="44" height="54" rx="8"/>
    <text class="keyfig__text" data-minus-key x="263" y="34" text-anchor="middle"></text>
    <rect class="keyfig__hot" x="291" y="1" width="44" height="54" rx="8"/>
    <text class="keyfig__hot-text" data-stacking-key x="313" y="34" text-anchor="middle"></text>
    <rect class="keyfig__key" x="341" y="1" width="82" height="54" rx="8"/>
    <text class="keyfig__text" x="382" y="34" text-anchor="middle">delete</text>
  </svg>
  <figcaption>{{ typing.stackingKey.caption | inline | safe }}</figcaption>
</figure>
{%- endif %}
{%- if d.id == 'mac' %}
<div class="callout">
  <h3>{{ typing.azerty.title }}</h3>
  <p>{{ typing.azerty.body | inline | safe }}</p>
  <a class="layout-pick" href="{{ typing.azerty.layout.url }}">
    <img src="{{ '/assets/img/tools/tibetan-wylie-azerty.png' | url }}" alt="" width="48" height="48">
    <span><strong>{{ typing.azerty.layout.name }}</strong><span>{{ typing.azerty.layout.text }}</span><span class="layout-pick__link">{{ typing.azerty.layout.link }}</span></span>
  </a>
  <p>{{ typing.azerty.afterLayout }}</p>
  <table class="keys">
    <thead><tr><th scope="col">To type</th><th scope="col">press the key marked</th></tr></thead>
    <tbody>
      {%- for k in typing.azerty.keys %}<tr><td><kbd>{{ k.type }}</kbd></td><td><span class="keycap">{{ k.press }}</span></td></tr>{% endfor %}
    </tbody>
  </table>
  <p>{{ typing.azerty.after | inline | safe }}</p>
</div>
{%- endif %}
{%- if d.font %}
<div class="font-box">
  <div class="font-box__text">
    <h3>{{ typing.font.title }}</h3>
    <p>{{ typing.font.body }} {{ d.font }}</p>
    <p class="actions"><a class="btn" href="{{ '/downloads/Jomolhari-Regular.ttf' | url }}" download><svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ typing.font.button }}</a></p>
    <p class="small">{{ typing.font.licence }} <a href="{{ '/downloads/Jomolhari-OFL.txt' | url }}">Read the licence</a>. Jomolhari is by Chris Fynn; this copy comes from Google Fonts.</p>
  </div>
  {#- The page already loads Jomolhari, so the sample is the font itself. #}
  <figure class="font-box__sample" aria-hidden="true">
    <span lang="bo">བོད་ཡིག</span>
    <figcaption>Jomolhari</figcaption>
  </figure>
</div>
{%- endif %}
