<section class="device" id="cheat-sheet" aria-labelledby="cheat-heading">
  <div class="cheat-card">
    <div class="cheat-card__text">
      <h2 id="cheat-heading">{{ typing.cheatSheet.title }}</h2>
      <p class="device__lead">{{ typing.cheatSheet.body }}</p>
      <p class="actions"><a class="btn" href="{{ '/downloads/wylie-cheat-sheet.pdf' | url }}" download>{{ typing.cheatSheet.button }}</a></p>
      <p class="small">To practise, paste your Wylie into the <a href="https://www.lotsawahouse.org/Static/tools/ewts.html" rel="noopener">Lotsawa House Wylie converter</a>: nothing needs installing.</p>
    </div>
    <a class="cheat-card__thumb" href="{{ '/downloads/wylie-cheat-sheet.pdf' | url }}" download aria-hidden="true" tabindex="-1">
      <img src="{{ '/assets/img/guide/wylie-cheat-sheet.webp' | url }}" alt="" width="182" height="257" loading="lazy">
    </a>
  </div>
</section>
